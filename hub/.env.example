# Copy to .env for local work, and set the same three in Vercel
# (Project > Settings > Environment Variables) for Production.
# The middleware returns 500 "Hub is not configured." if any one is missing.

# The password you give the client. One per hub.
HUB_PASSWORD=

# Signing key for the session cookie. 32 random bytes, hex encoded.
# Generate with:  openssl rand -hex 32
# Rotating this logs every client session out immediately.
HUB_COOKIE_SECRET=

# Must match client.slug in hub.config.ts. It is signed into the cookie, so a
# session minted for one client hub cannot be replayed against another.
HUB_SLUG=
