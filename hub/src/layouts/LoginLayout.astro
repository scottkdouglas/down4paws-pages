---
import '@/styles/global.css';
import hub from '@hub';
import type { HubConfig } from '@/lib/types';

const brand: HubConfig['brand'] = hub.brand;
const favicon = brand.favicon ?? brand.logo;

interface Props {
  title: string;
}

const { title } = Astro.props;

// Brand colours come from hub.config.ts and ride on the root element as custom
// properties, so the markup stays client-agnostic.
const brandVars = `--hub-primary: ${hub.brand.primary}; --hub-secondary: ${hub.brand.secondary};`;
---

<html lang="en" style={brandVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type={favicon.endsWith('.svg') ? 'image/svg+xml' : 'image/png'} href={favicon} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <main class="flex min-h-screen items-center justify-center px-4 py-12">
      <slot />
    </main>
  </body>
</html>
