---
import { getCollection } from 'astro:content';
import NumbersStrip from '@/components/widgets/NumbersStrip.astro';
import Empty from '@/components/ui/Empty.astro';

const numbers = await getCollection('numbers');

const groups = new Map<string, typeof numbers>();
for (const n of numbers) {
  const key = n.data.group ?? '';
  const existing = groups.get(key);
  if (existing) {
    existing.push(n);
  } else {
    groups.set(key, [n]);
  }
}
const sortedGroupKeys = [...groups.keys()].sort((a, b) => a.localeCompare(b));
---

{
  numbers.length === 0 ? (
    <Empty message="No numbers yet." />
  ) : (
    <div class="space-y-6">
      {sortedGroupKeys.map((key) => (
        <div>
          {key && <h2 class="mb-2 text-sm font-semibold text-ink">{key}</h2>}
          <NumbersStrip metrics={groups.get(key) ?? []} />
        </div>
      ))}
    </div>
  )
}
