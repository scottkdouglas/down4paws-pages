---
import type { CollectionEntry } from 'astro:content';
import Badge from '@/components/ui/Badge.astro';
import { fmtDate } from '@/lib/dates';
import hub from '@hub';

interface Props {
  metric: CollectionEntry<'numbers'>;
}

const { metric } = Astro.props;
const { label, value, delta, note, source, asOf } = metric.data;
const tz = hub.client.timezone;
---

<div class="rounded-lg border border-line bg-white p-4">
  <p class="text-xs font-medium uppercase tracking-wide text-ink-soft">{label}</p>
  <p class="mt-1 text-2xl font-semibold text-ink">{value}</p>
  {
    delta && (
      <p class="mt-1 text-xs text-ink-soft">
        {delta.direction === 'flat' ? 'No change' : `${delta.value} ${delta.direction}`} ({delta.period})
      </p>
    )
  }
  {note && <p class="mt-1 text-xs text-ink-soft">{note}</p>}
  <div class="mt-3 flex items-center justify-between gap-2">
    <Badge tone="neutral">{source}</Badge>
    <span class="text-[11px] text-ink-soft">as of {fmtDate(asOf, tz)}</span>
  </div>
</div>
