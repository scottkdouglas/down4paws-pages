---
import hub from '@hub';

const buildTime = new Date();
const formatted = new Intl.DateTimeFormat('en-US', {
  timeZone: hub.client.timezone,
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
}).format(buildTime);
---

<p class="border-t border-line pt-4 text-xs text-ink-soft">Last updated {formatted}</p>
