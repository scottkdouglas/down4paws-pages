---
import Layout from '../layouts/Layout.astro';

// Registration: Acuity appointment type "Calm Before Commands (Online Workshop)", Sun Sept 27 2026.
const ACUITY_APPOINTMENT_TYPE = '97862526';
const acuityUrl = `https://app.acuityscheduling.com/schedule.php?owner=24021188&appointmentType=${ACUITY_APPOINTMENT_TYPE}`;
---

<Layout
  title="Calm Before Commands: Free Online Dog Training Workshop | Down 4 Paws"
  description="Join CCDT dog trainer Pam Brown for a free 90-minute live online workshop on Sunday, September 27 at 11 AM ET. Learn why your dog seems to forget training when overwhelmed, and what to do before you repeat the cue."
>
  <!-- HEADER -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-sm">
    <div class="max-w-5xl mx-auto px-5 md:px-8 py-3.5 flex items-center justify-between">
      <a href="https://down4paws.com">
        <img src="/images/d4p-logo.png" alt="Down 4 Paws Dog Training" class="h-9 md:h-10" />
      </a>
      <a
        href="#register"
        data-cta="header"
        class="font-display text-sm md:text-base bg-orange text-white px-4 md:px-5 py-2 rounded-full hover:bg-orange-bright transition-colors whitespace-nowrap"
      >
        Save My Free Spot
      </a>
    </div>
  </header>

  <!-- 1. HERO -->
  <section class="bg-cream pt-24 md:pt-32 pb-12 md:pb-16">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <div class="grid md:grid-cols-12 gap-10 md:gap-8 items-center">
        <div class="md:col-span-7">
          <p class="inline-flex items-center gap-2 bg-purple-mist text-purple text-xs font-bold tracking-widest uppercase rounded-full px-4 py-1.5 mb-6">
            <span class="w-2 h-2 bg-orange rounded-full"></span>
            Free live online workshop
          </p>

          <h1 class="font-display text-charcoal text-[clamp(1.9rem,4.6vw,3.2rem)] leading-[1.08] mb-6">
            Your dog knows it at home.
            <span class="text-orange block">Outside, it's like they never heard the word.</span>
          </h1>

          <!-- Workshop details, prominent above the fold -->
          <div class="bg-white border-l-4 border-orange rounded-r-2xl shadow-sm px-5 py-4 mb-6 max-w-xl">
            <p class="font-display text-charcoal text-xl md:text-2xl leading-snug">Sunday, September 27</p>
            <p class="font-display text-charcoal text-xl md:text-2xl leading-snug">11:00 AM to 12:30 PM Eastern</p>
            <p class="text-purple font-semibold text-lg md:text-xl mt-1">Live online with Pam Brown, CCDT</p>
          </div>

          <p class="text-charcoal text-lg md:text-xl leading-relaxed max-w-xl mb-7">
            <strong class="font-semibold">Calm Before Commands</strong> is a free 90-minute workshop for families whose dogs seem to forget everything when the world gets busy. Learn what's happening before your dog becomes overwhelmed, and what to do instead of repeating the cue louder.
          </p>

          <a
            href="#register"
        data-cta="hero"
            class="inline-flex items-center gap-3 font-display bg-purple text-white text-lg px-8 py-4 rounded-full hover:bg-purple-deep transition-colors"
          >
            Save My Free Spot
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>

          <p class="text-warm-gray text-base mt-5">
            Free. Can't make it live? Register anyway and get the replay.
          </p>
        </div>

        <div class="md:col-span-5">
          <div class="relative rounded-3xl overflow-hidden shadow-xl shadow-charcoal/10">
            <img
              src="/images/hero-split.jpg"
              alt="The same dog calm and relaxed at home on the left, then alert and braced on a busy path on the right"
              class="w-full h-auto object-cover"
              loading="eager"
            />
            <div class="absolute inset-x-0 bottom-0 p-4">
              <span class="bg-white/90 backdrop-blur-sm text-charcoal font-display text-sm px-4 py-2 rounded-full shadow-sm">
                Calm at home. A different dog outside.
              </span>
            </div>
          </div>
          <p class="text-warm-gray text-base mt-4 text-center md:text-left">
            Down 4 Paws Dog Training, Norwood MA · 83 five-star Google reviews
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SOUND FAMILIAR + BEHAVIOR TRANSLATION -->
  <section class="bg-charcoal py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <div class="grid md:grid-cols-12 gap-10 md:gap-14">
        <div class="md:col-span-5">
          <p class="font-display text-orange text-sm tracking-widest uppercase mb-6">Sound familiar?</p>
          <ul class="space-y-6 text-white text-lg md:text-xl leading-relaxed">
            <li>"He does a perfect sit in the kitchen. Another dog shows up and he acts like he's never heard the word."</li>
            <li>"She was doing so well. Then she hit adolescence and it feels like it all fell apart."</li>
            <li>"I said leave it four times. Louder each time. He stared right through me."</li>
          </ul>
        </div>

        <div class="md:col-span-7">
          <p class="font-display text-orange text-sm tracking-widest uppercase mb-6">Here's the deal</p>
          <p class="font-display text-white text-2xl md:text-3xl leading-tight mb-8">
            Your dog probably isn't ignoring you.
          </p>

          <dl class="space-y-5 border-l-2 border-orange/60 pl-5">
            <div>
              <dt class="text-orange text-sm font-bold tracking-widest uppercase mb-1">What you see</dt>
              <dd class="text-white text-base md:text-lg leading-relaxed">A dog who "knows" the cue and won't do it.</dd>
            </div>
            <div>
              <dt class="text-orange text-sm font-bold tracking-widest uppercase mb-1">What your dog may be feeling</dt>
              <dd class="text-white text-base md:text-lg leading-relaxed">Too much at once. The brain is full.</dd>
            </div>
            <div>
              <dt class="text-orange text-sm font-bold tracking-widest uppercase mb-1">Behavior Translation</dt>
              <dd class="text-white text-base md:text-lg leading-relaxed">Knowing a skill and being able to use it in the moment are two different things.</dd>
            </div>
          </dl>

          <p class="mt-10 pt-6 border-t border-white/15 font-display text-white text-xl md:text-2xl">
            Your dog isn't giving you a hard time.<br />
            <span class="text-orange">They're having a hard time.</span>
          </p>
          <p class="text-white/90 text-base md:text-lg leading-relaxed mt-4">
            What to do about it, and how to spot it before the cue is lost, is what we cover in the workshop.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. WHAT YOU'LL WALK AWAY WITH -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <div class="max-w-2xl mb-10 md:mb-12">
        <p class="font-display text-orange text-sm tracking-widest uppercase mb-3">In 90 minutes</p>
        <h2 class="font-display text-charcoal text-3xl md:text-4xl leading-tight mb-4">
          What you'll walk away with
        </h2>
        <p class="text-warm-gray text-lg leading-relaxed">
          One idea, taught properly. Not forty tips you'll forget by Tuesday.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <div class="bg-cream rounded-2xl p-6 md:p-7 border border-beige">
          <p class="font-display text-purple text-lg mb-2">The early signs of overwhelm</p>
          <p class="text-charcoal text-base leading-relaxed">What your dog does before the bark, the lunge, or the shutdown. So you can catch it in time.</p>
        </div>
        <div class="bg-cream rounded-2xl p-6 md:p-7 border border-beige">
          <p class="font-display text-purple text-lg mb-2">Notice → Process → Reconnect → Respond</p>
          <p class="text-charcoal text-base leading-relaxed">A four-step framework for what to do before you give another command.</p>
        </div>
        <div class="bg-cream rounded-2xl p-6 md:p-7 border border-beige">
          <p class="font-display text-purple text-lg mb-2">Why "she regressed" is normal</p>
          <p class="text-charcoal text-base leading-relaxed">What adolescence does to a dog who was doing great. Bad days don't erase progress.</p>
        </div>
        <div class="bg-cream rounded-2xl p-6 md:p-7 border border-beige">
          <p class="font-display text-purple text-lg mb-2">Five things to try this week</p>
          <p class="text-charcoal text-base leading-relaxed">Real walks, real visitors, real life. No perfect conditions required.</p>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a
          href="#register"
        data-cta="mid"
          class="inline-flex items-center gap-3 font-display bg-purple text-white text-lg px-8 py-4 rounded-full hover:bg-purple-deep transition-colors"
        >
          Save My Free Spot
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. PROOF + PAM -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <p class="font-display text-orange text-sm tracking-widest uppercase mb-8">Real dogs, real life</p>

      <div class="grid md:grid-cols-3 gap-5 mb-14">
        <div class="bg-white rounded-2xl p-6 border border-beige">
          <p class="font-display text-purple text-lg leading-snug mb-3">The fix wasn't a new command. It was catching him sooner.</p>
          <p class="text-charcoal text-base leading-relaxed mb-4">
            Archie was great in training and a mess on neighborhood walks: pulling, reacting to dogs on porches. His owner learned to get his attention earlier and make space before he tipped over.
          </p>
          <p class="text-warm-gray text-sm"><span class="font-semibold text-charcoal">Archie</span> · Mixed breed, young adult</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-beige">
          <p class="font-display text-purple text-lg leading-snug mb-3">From pacing all night to sleeping through.</p>
          <p class="text-charcoal text-base leading-relaxed mb-4">
            Maisie was good at home and overwhelmed outside. One packed day of walk, car, errands and a new dog, and she couldn't settle. Once her owner learned to spot the overload and build in rest, the evenings calmed down.
          </p>
          <p class="text-warm-gray text-sm"><span class="font-semibold text-charcoal">Maisie</span> · Golden Retriever, puppy</p>
        </div>
        <div class="bg-purple rounded-2xl p-6 text-white">
          <p class="text-white/80 text-sm font-bold tracking-widest uppercase mb-4">Google review</p>
          <p class="text-white text-base leading-relaxed mb-4">
            "Before Pam, whenever he saw another dog on a walk, he would start barking and lunging. After Pam, he clocks another dog but does not get distracted or reactive."
          </p>
          <p class="text-white/80 text-sm">Arthur's family</p>
        </div>
      </div>

      <div class="grid md:grid-cols-12 gap-8 items-center bg-white rounded-3xl p-7 md:p-10 border border-beige">
        <div class="md:col-span-3 flex justify-center md:justify-start">
          <img src="/images/pam-profile.jpg" alt="Pam Brown, CCDT, Down 4 Paws Dog Training" class="w-32 h-32 md:w-40 md:h-40 rounded-2xl object-cover shadow-md" />
        </div>
        <div class="md:col-span-9">
          <p class="font-display text-purple text-xl mb-1">Pam Brown, CCDT</p>
          <p class="text-warm-gray text-base mb-4">Founder &amp; Head Trainer, Down 4 Paws Dog Training</p>
          <p class="text-charcoal text-lg leading-relaxed mb-4">
            Almost every family I meet says the same thing first: "He knows this. He's just not listening." I teach this workshop because I help families recognize what their dog is communicating before the behavior escalates.
          </p>
          <p class="text-charcoal text-lg leading-relaxed">
            When you can spot the early signs of overwhelm, you can help your dog recover and reconnect instead of asking for something they're not ready to give. That's the shift I want you to leave with.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. REGISTER -->
  <section id="register" class="bg-charcoal py-16 md:py-24 scroll-mt-16">
    <div class="max-w-2xl mx-auto px-5 md:px-8">
      <div class="text-center mb-8">
        <p class="font-display text-orange text-sm tracking-widest uppercase mb-3">Free registration</p>
        <h2 class="font-display text-white text-3xl md:text-4xl mb-4">Save your free spot</h2>
        <p class="text-white text-lg md:text-xl font-semibold">Sunday, September 27</p>
        <p class="text-white text-lg md:text-xl">11:00 AM to 12:30 PM Eastern · Live online</p>
        <p class="text-white/80 text-base mt-3">Can't make it live? Register anyway. Everyone who registers gets the replay.</p>
      </div>

      <!-- Acuity Embed: Calm Before Commands, Sept 27, 2026 -->
      <div class="bg-white rounded-3xl shadow-2xl shadow-black/20 overflow-hidden">
        <iframe
          src={acuityUrl}
          width="100%"
          height="800"
          frameborder="0"
          allow="payment"
          title="Workshop Registration"
          class="block w-full min-h-[500px]"
        ></iframe>
      </div>
      <script is:inline src="https://embed.acuityscheduling.com/js/embed.js"></script>

      <div class="mt-12 space-y-3">
        <details class="group bg-white/5 rounded-xl px-5 py-4">
          <summary class="cursor-pointer text-white text-base md:text-lg font-semibold list-none flex justify-between items-center gap-4">
            Do I need my dog with me?
            <span class="text-orange group-open:rotate-45 transition-transform text-xl leading-none flex-shrink-0">+</span>
          </summary>
          <p class="text-white/90 text-base mt-3 leading-relaxed">No. This one is for you. Watch, take notes, then practice this week.</p>
        </details>
        <details class="group bg-white/5 rounded-xl px-5 py-4">
          <summary class="cursor-pointer text-white text-base md:text-lg font-semibold list-none flex justify-between items-center gap-4">
            Is it only for reactive dogs?
            <span class="text-orange group-open:rotate-45 transition-transform text-xl leading-none flex-shrink-0">+</span>
          </summary>
          <p class="text-white/90 text-base mt-3 leading-relaxed">No. It's for any dog who does great at home and struggles outside, in adolescence, around visitors, or in busy places.</p>
        </details>
        <details class="group bg-white/5 rounded-xl px-5 py-4">
          <summary class="cursor-pointer text-white text-base md:text-lg font-semibold list-none flex justify-between items-center gap-4">
            Is this a sales pitch?
            <span class="text-orange group-open:rotate-45 transition-transform text-xl leading-none flex-shrink-0">+</span>
          </summary>
          <p class="text-white/90 text-base mt-3 leading-relaxed">The workshop stands on its own. At the end I'll mention how to work with me if you want more support. That's it.</p>
        </details>
        <details class="group bg-white/5 rounded-xl px-5 py-4">
          <summary class="cursor-pointer text-white text-base md:text-lg font-semibold list-none flex justify-between items-center gap-4">
            Do I need to be near Boston?
            <span class="text-orange group-open:rotate-45 transition-transform text-xl leading-none flex-shrink-0">+</span>
          </summary>
          <p class="text-white/90 text-base mt-3 leading-relaxed">No. It's online. Join from anywhere.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-white border-t border-beige py-10">
    <div class="max-w-5xl mx-auto px-5 md:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <img src="/images/d4p-logo.png" alt="Down 4 Paws" class="h-9" />
      <div class="flex items-center gap-4 text-sm text-warm-gray">
        <a href="https://down4paws.com" class="hover:text-purple transition-colors">down4paws.com</a>
        <span class="w-1 h-1 bg-warm-gray/30 rounded-full"></span>
        <a href="https://instagram.com/down4paws" class="hover:text-purple transition-colors">@down4paws</a>
      </div>
      <p class="text-sm text-warm-gray">&copy; 2026 Down 4 Paws</p>
    </div>
  </footer>

  <style is:global>
    html { scroll-behavior: smooth; }
    details summary::-webkit-details-marker { display: none; }
  </style>
  <script>
    import { track } from '@vercel/analytics';

    document.querySelectorAll<HTMLAnchorElement>('a[data-cta]').forEach((a) => {
      a.addEventListener('click', () => {
        track('cta_click', { location: a.dataset.cta ?? 'unknown' });
      });
    });

    const register = document.getElementById('register');
    if (register && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          track('register_view');
          io.disconnect();
        }
      }, { threshold: 0.25 });
      io.observe(register);
    }
  </script>
</Layout>
